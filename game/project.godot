; Engine configuration file.
; Godot 4.7.2-stable (.NET). Pinned in docs/visual/TOOLCHAIN.md.

config_version=5

[application]

config/name="Cloverbrook Stables"
config/description="Cozy horse breeding and stable management. Visual pilot."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/bg_color=Color(0.98, 0.93, 0.95, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Cloverbrook.Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/horse_asset_evidence/plugin.cfg")

[input]

orbit_left={"deadzone": 0.2, "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":97,"location":0,"echo":false,"script":null)]}
orbit_right={"deadzone": 0.2, "events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":68,"key_label":0,"unicode":100,"location":0,"echo":false,"script":null)]}

[rendering]

renderer/rendering_method.macos="gl_compatibility"
renderer/rendering_method.mobile.macos="gl_compatibility"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/screen_space_aa.macos=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.96, 0.92, 0.95, 1)
textures/canvas_textures/default_texture_filter=1
textures/vram_compression/import_etc2_astc=true
