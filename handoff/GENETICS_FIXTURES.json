  "pedigreeFixtures": {
    "scope": "Mathematical kinship cases only; a mathematically evaluable pair is not necessarily eligible for breeding under game policy.",
    "assumptions": [
      "All founders listed in sharedPedigree are mutually unrelated and non-inbred unless a case explicitly overrides founder data.",
      "The sharedPedigree is complete for these synthetic cases.",
      "Parent order and sex are irrelevant to these autosomal pedigree calculations.",
      "The requested value is the proposed offspring inbreeding coefficient F, equal to kinship phi between its parents, not their coefficient of relationship.",
      "An unknown real ancestry record does not establish zero kinship."
    ],
    "recurrence": {
      "offspringInbreeding": "F(child) = phi(parentA, parentB)",
      "selfKinship": "phi(i, i) = (1 + F(i)) / 2",
      "newChildToOlderIndividual": "phi(child, j) = (phi(parentA, j) + phi(parentB, j)) / 2"
    },
