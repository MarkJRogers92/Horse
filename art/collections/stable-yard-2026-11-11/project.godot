config_version=5

[application]
config/name="Cloverbrook Asset Collection"
run/main_scene="res://Gallery.tscn"

[display]
window/size/viewport_width=1200
window/size/viewport_height=800

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.12,0.16,0.14,1)
